# Optional: store RSVPs in Supabase. Leave empty to run in local/demo mode
# (responses are kept only in the guest's browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Table name (defaults to "rsvps")
VITE_SUPABASE_RSVP_TABLE=rsvps
# Guestbook table name (defaults to "guestbook")
VITE_SUPABASE_GUESTBOOK_TABLE=guestbook
